#!/usr/bin/env python3
"""Show Claude Code's state on a light. Meant to be called from hooks.

Usage: lights-status {working|needs-you|done|off|on|state}

  working    blue
  needs-you  orange
  done       green for HOLD seconds, then the light returns to what it was
  off        disable the status light (restores the light if it is mid-status)
  on         enable it again
  state      print whether it is enabled

Which light is used: `status_device` in devices.toml (default: the default light).
The call returns immediately; the work happens in a detached process.
If the light is off or unreachable, nothing happens.
"""
import fcntl
import json
import subprocess
import sys
import time

from lightsctl import config

CACHE = config.CACHE
LATEST = CACHE / "latest"
SAVED = CACHE / "saved.json"
LOCK = CACHE / "lock"
DISABLED = CACHE / "disabled"
HOLD = 8

COLORS = {
    "working": (0, 60, 255),
    "needs-you": (255, 110, 0),
    "done": (0, 255, 60),
}


def get_light():
    cfg = config.load()
    return config.make(cfg, config.status_name(cfg))


def restore(light):
    if not SAVED.exists():
        return
    saved = json.loads(SAVED.read_text())
    SAVED.unlink(missing_ok=True)
    if light.fingerprint() == saved.get("applied"):  # otherwise it was changed by hand: leave it
        light.restore(saved["snap"])


def is_latest(token):
    return LATEST.exists() and LATEST.read_text() == token


class locked:
    def __enter__(self):
        self.f = open(LOCK, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def run(event, token):
    """Detached worker: apply the event unless a newer one has arrived."""
    light = get_light()
    with locked():
        if not is_latest(token):
            return
        if not SAVED.exists():
            if not light.status()["on"]:
                return  # switched off: leave it alone
            SAVED.write_text(json.dumps({"snap": light.snapshot()}))
        light.color(COLORS[event])
        saved = json.loads(SAVED.read_text())
        saved["applied"] = light.fingerprint()
        SAVED.write_text(json.dumps(saved))

    if event != "done":
        return
    time.sleep(HOLD)
    with locked():
        if is_latest(token):
            restore(light)


def main(argv):
    if len(argv) == 3 and argv[0] == "--run":
        try:
            run(argv[1], argv[2])
        except Exception as e:  # never bother the caller
            (CACHE / "error.log").open("a").write(f"{time.ctime()} {e!r}\n")
        return
    if len(argv) != 1 or argv[0] not in (*COLORS, "off", "on", "state"):
        sys.exit(__doc__)
    CACHE.mkdir(parents=True, exist_ok=True)
    if argv[0] == "state":
        print("off" if DISABLED.exists() else "on")
        return
    if argv[0] == "on":
        DISABLED.unlink(missing_ok=True)
        print("lights-status: on")
        return
    if argv[0] == "off":
        DISABLED.touch()
        LATEST.write_text(str(time.time_ns()))  # cancels any pending restore or event
        with locked():
            try:
                restore(get_light())
            except Exception as e:
                SAVED.unlink(missing_ok=True)
                print(f"could not restore the light: {e!r}")
        print("lights-status: off")
        return
    if DISABLED.exists():
        return
    token = str(time.time_ns())
    LATEST.write_text(token)
    subprocess.Popen(
        [sys.executable, __file__, "--run", argv[0], token],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


if __name__ == "__main__":
    main(sys.argv[1:])
