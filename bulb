#!/usr/bin/env python3
"""Control the Wipro/Tuya bulb over the LAN.

Usage: bulb {on|off|status|brightness N|color R G B|color NAME|white [TEMP]|fix-ip}
  brightness N   1-100
  white [TEMP]   white mode, optional colour temperature 0-100 (warm -> cool)
  fix-ip         find the bulb on the network again and update TUYA_DEVICE_IP in .env
Settings come from .env next to this script.
"""
import re
import socket
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

import tinytuya

COLORS = {
    "red": (255, 0, 0), "green": (0, 255, 0), "blue": (0, 0, 255),
    "yellow": (255, 255, 0), "orange": (255, 100, 0), "purple": (150, 0, 255),
    "pink": (255, 60, 150), "cyan": (0, 255, 255),
}


def load_env():
    env = {}
    for line in (Path(__file__).parent / ".env").read_text().splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip()
    return env


def find_ip(env):
    """Look for the bulb by UDP broadcast, then by probing the local /24."""
    dev_id = env["TUYA_DEVICE_ID"]
    print("Scanning (broadcast)...")
    for ip, info in tinytuya.deviceScan(False, 20).items():
        if info.get("gwId") == dev_id:
            return ip

    print("Not found, probing the local subnet...")
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect(("8.8.8.8", 80))
    base = s.getsockname()[0].rsplit(".", 1)[0]
    s.close()

    def probe(ip):
        try:
            socket.create_connection((ip, 6668), timeout=1).close()
        except OSError:
            return None
        dev = tinytuya.Device(dev_id, ip, env["TUYA_LOCAL_KEY"], version=float(env.get("TUYA_VERSION", 3.1)))
        dev.set_socketRetryLimit(1)
        res = dev.status()
        return ip if res and "dps" in res else None

    with ThreadPoolExecutor(64) as pool:
        for ip in pool.map(probe, [f"{base}.{i}" for i in range(1, 255)]):
            if ip:
                return ip
    return None


def fix_ip():
    env_file = Path(__file__).parent / ".env"
    env = load_env()
    ip = find_ip(env)
    if not ip:
        sys.exit("error: bulb not found. Check it has power and is on the same network.")
    text = env_file.read_text()
    text = re.sub(r"^TUYA_DEVICE_IP=.*$", f"TUYA_DEVICE_IP={ip}", text, flags=re.M)
    env_file.write_text(text)
    old = env.get("TUYA_DEVICE_IP")
    print(f"Bulb is at {ip}" + (" (unchanged)" if ip == old else f" (was {old}), .env updated"))


def main(argv):
    if not argv:
        sys.exit(__doc__)
    if argv[0] == "fix-ip":
        return fix_ip()
    env = load_env()
    bulb = tinytuya.BulbDevice(
        env["TUYA_DEVICE_ID"], env["TUYA_DEVICE_IP"], env["TUYA_LOCAL_KEY"],
        version=float(env.get("TUYA_VERSION", 3.1)),
    )
    cmd, args = argv[0], argv[1:]
    if cmd == "on":
        res = bulb.turn_on()
    elif cmd == "off":
        res = bulb.turn_off()
    elif cmd == "status":
        res = bulb.status()
    elif cmd == "brightness":
        # tinytuya's HSV path crashes on this bulb, so write the DPs directly
        pct = max(1, min(100, int(args[0])))
        dps = bulb.status()["dps"]
        if dps.get("2") == "colour":
            h = dps["5"]  # rrggbb hhhh ss vv
            res = bulb.set_value(5, h[:12] + format(round(pct * 255 / 100), "02x"))
        else:
            res = bulb.set_value(3, round(25 + (255 - 25) * pct / 100))
    elif cmd == "white":
        bulb.set_mode("white")
        res = bulb.set_colourtemp_percentage(int(args[0])) if args else None
    elif cmd == "color":
        rgb = COLORS[args[0]] if len(args) == 1 else tuple(int(a) for a in args[:3])
        res = bulb.set_colour(*rgb)
    else:
        sys.exit(__doc__)
    if res and "Error" in res:
        sys.exit(f"error: {res['Error']}")
    print(res if cmd == "status" else "ok")


if __name__ == "__main__":
    main(sys.argv[1:])
